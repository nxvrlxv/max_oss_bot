# Единственная точка входа снаружи: HTTPS, статика мини-приложения,
# /api — в Go, /webhook — боту. Сертификат Let's Encrypt Caddy получает
# и продлевает сам, нужны открытые 80 и 443 и DNS-имя, указывающее на сервер.
{$DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /webhook* {
		reverse_proxy bot:8081
	}

	handle {
		root * /srv
		# Файлы сборки с хешем в имени кешируются навсегда, index.html — никогда:
		# иначе после деплоя клиенты MAX держат старую версию.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# X-Frame-Options не ставим: веб-версия MAX открывает мини-приложение во фрейме.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
