# Образец настроек. Скопируйте в .env и заполните — .env в git не попадает.

# --- Домен ---
# Имя, по которому сервер доступен из интернета. Для сервера без своего домена
# подойдёт sslip.io: для IP 178.236.254.46 это 178-236-254-46.sslip.io.
# Caddy сам получит на него сертификат. Локально — localhost.
DOMAIN=localhost

# --- Бот ---
# Токен выдаётся на платформе MAX. Рабочий токен сюда не коммитить.
BOT_TOKEN=
# polling — без внешнего адреса, webhook — на сервере с HTTPS
BOT_MODE=polling
MAX_API_BASE=https://platform-api.max.ru/
# Адрес мини-приложения. Сам бот его не использует: этот же адрес
# нужно указать в настройках бота на платформе MAX.
WEBAPP_URL=https://localhost/

# --- Вебхук (только при BOT_MODE=webhook) ---
# Caddy пересылает /webhook боту: https://<DOMAIN>/webhook
WEBHOOK_URL=
# Случайная строка, MAX присылает её в заголовке X-Max-Bot-Api-Secret
WEBHOOK_SECRET=
WEBHOOK_ADDR=:8081

# --- API мини-приложения ---
API_ADDR=:8080
# Только для разработки в браузере без MAX: запросы без initData идут
# от этого max_id. В compose.yaml принудительно выключено.
DEV_MAX_ID=

# --- База ---
POSTGRES_USER=oss
POSTGRES_PASSWORD=oss
POSTGRES_DB=oss
POSTGRES_PORT=5432
# Для запуска вне Docker; в compose.yaml адрес подменяется на db:5432.
DATABASE_URL=postgres://oss:oss@localhost:5432/oss?sslmode=disable
